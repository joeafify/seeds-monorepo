{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": true,
    "allowJs": true,
    "strict": true,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "packages/**/src/**/*.js",
    "packages/**/src/**/*.ts",
    "packages/**/src/**/*.svelte",
    "packages/**/tests/**/*.ts",
    "packages/**/tests/**/*.js",
    "packages/**/tests/**/*.svelte",
    "packages/ui/eslint.config.mts",
    "packages/server/src/app.ts",
    "packages/server/config.ts",
    "packages/server/index.ts",
    "packages/server/load-data.ts",
    "packages/server/routes.ts"
  ],
  "exclude": [
    "**/assets/**/*",
    "node_modules",
    "dist"
  ]
}